# Copy to .env and adjust. Never commit .env.
ENVIRONMENT=development
DEBUG=false
CORS_ORIGINS=["http://localhost:3000","https://datapanthersolutions.com","https://www.datapanthersolutions.com"]

# Local Postgres (docker compose up -d)
POSTGRES_USER=datapanther
POSTGRES_PASSWORD=datapanther
POSTGRES_DB=datapanther
POSTGRES_PORT=5432
DATABASE_URL=postgresql://datapanther:datapanther@localhost:5432/datapanther

# Chat assistant: API key from https://platform.claude.com (Settings > API keys).
# Without it, POST /api/v1/chat answers 503 and the website shows a "chat unavailable" message.
ANTHROPIC_API_KEY=
CHAT_MODEL=claude-opus-5-5
CHAT_EFFORT=low
CHAT_RATE_PER_MINUTE=8
CHAT_RATE_PER_DAY=120
