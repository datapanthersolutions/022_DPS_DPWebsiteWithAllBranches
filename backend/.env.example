# Copy to .env and adjust. Never commit .env.
ENVIRONMENT=development
DEBUG=false
CORS_ORIGINS=["http://localhost:3000","https://datapanthersolutions.com","https://www.datapanthersolutions.com"]

# Local Postgres (docker compose up -d)
POSTGRES_USER=datapanther
POSTGRES_PASSWORD=datapanther
POSTGRES_DB=datapanther
POSTGRES_PORT=5432
DATABASE_URL=postgresql://datapanther:datapanther@localhost:5432/datapanther

# HubSpot: docs/integrations/hubspot.md
HUBSPOT_PORTAL_ID=
HUBSPOT_ACCESS_TOKEN=
HUBSPOT_CONTACT_FORM_ID=
HUBSPOT_NEWSLETTER_FORM_ID=
HUBSPOT_TALENT_FORM_ID=

# GA4 Measurement Protocol: docs/integrations/ga4.md
GA4_MEASUREMENT_ID=
GA4_API_SECRET=
