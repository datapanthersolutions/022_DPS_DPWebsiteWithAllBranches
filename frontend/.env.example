# Build-time settings for the website. These are public (they end up in the HTML).
# For production, put them in frontend/.env.production before `npm run build`.

# Google Tag Manager container, e.g. GTM-ABC1234. Leave empty to load no tags (local dev).
NEXT_PUBLIC_GTM_ID=

# FastAPI backend that receives the forms, e.g. https://api.datapanthersolutions.com
NEXT_PUBLIC_API_URL=http://localhost:8000
