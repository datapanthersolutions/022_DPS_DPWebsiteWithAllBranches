# Build-time settings for the website. These are public (they end up in the JavaScript).
# For production, put them in frontend/.env.production before `npm run build`.

# Chat assistant. Leave false to answer from the website's own content (no AI, no backend needed).
# Set to true once the backend has an ANTHROPIC_API_KEY, to answer typed questions with AI.
NEXT_PUBLIC_CHAT_AI=false

# FastAPI backend, e.g. https://api.datapanthersolutions.com (only used when NEXT_PUBLIC_CHAT_AI=true)
NEXT_PUBLIC_API_URL=http://localhost:8000
